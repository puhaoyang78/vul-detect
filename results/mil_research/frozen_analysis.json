    "meaning": "analytical diagnostic, not a trained model; P-C alone can reward prediction decorrelation; interpret together with P-R/AUC/MCC"
  },
  "intervention_definitions": {
    "original": "a_i=n_i*r_i/sum_j(n_j*r_j), shared linear classifier",
    "token_mean": "all visible code tokens receive equal weight",
    "line_mean": "equal weight per effective code line",
    "attention_top3": "select the 3 greatest actual attention masses a_i, then token mean within selected lines",
    "rate_top3": "select the 3 greatest bounded multipliers r_i, then token mean within selected lines",
    "risk_top3": "select the 3 greatest shared-classifier line projections, then token mean; projections are not trained line-risk probabilities",
    "remove_attention_top3": "remove the 3 greatest actual attention masses and renormalize the original weights on remaining lines; keep original if no line remains"
  }
